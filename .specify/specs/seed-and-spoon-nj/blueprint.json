  },
  "workflows": [
    {
      "id": "volunteer_registration",
      "name": "Volunteer Registration Flow",
      "steps": [
        {"step": 1, "action": "Fill registration form", "actor": "Visitor"},
        {"step": 2, "action": "Validate form data", "actor": "System"},
        {"step": 3, "action": "Create auth user", "actor": "System", "table": "auth.users"},
        {"step": 4, "action": "Create volunteer profile", "actor": "System", "table": "volunteers"},
        {"step": 5, "action": "Send welcome email", "actor": "System"},
        {"step": 6, "action": "Redirect to dashboard", "actor": "System"}
      ]
    },
    {
      "id": "referral_submission",
      "name": "Partner Referral Submission",
      "steps": [
        {"step": 1, "action": "Partner creates referral", "actor": "Partner", "table": "referrals"},
        {"step": 2, "action": "Generate referral number", "actor": "System"},
        {"step": 3, "action": "Notify admin", "actor": "System"},
        {"step": 4, "action": "Admin reviews", "actor": "Admin"},
        {"step": 5, "action": "Accept/reject referral", "actor": "Admin", "table": "referrals"},
        {"step": 6, "action": "Assign volunteer/food bank", "actor": "Admin", "table": "referrals"},
        {"step": 7, "action": "Notify volunteer and partner", "actor": "System"},
        {"step": 8, "action": "Volunteer delivers service", "actor": "Volunteer"},
        {"step": 9, "action": "Log activity", "actor": "Volunteer", "table": "referral_notes"},
        {"step": 10, "action": "Mark completed", "actor": "Volunteer", "table": "referrals"}
      ],
      "statuses": ["submitted", "under_review", "accepted", "assigned", "in_progress", "completed", "closed", "rejected"]
    },
    {
      "id": "donation_flow",
      "name": "Donation Flow",
      "steps": [
        {"step": 1, "action": "Select amount and type", "actor": "Donor"},
        {"step": 2, "action": "Create Stripe checkout session", "actor": "System", "external": "Stripe"},
        {"step": 3, "action": "Redirect to Stripe", "actor": "System"},
        {"step": 4, "action": "Complete payment", "actor": "Donor", "external": "Stripe"},
        {"step": 5, "action": "Receive webhook", "actor": "System", "external": "Stripe"},
        {"step": 6, "action": "Create donation record", "actor": "System", "table": "donations"},
        {"step": 7, "action": "Update campaign if applicable", "actor": "System", "table": "campaigns"},
        {"step": 8, "action": "Send receipt email", "actor": "System"},
        {"step": 9, "action": "Redirect to success page", "actor": "System"}
      ]
    },
    {
      "id": "hour_logging",
      "name": "Volunteer Hour Logging",
      "steps": [
        {"step": 1, "action": "Select program and date", "actor": "Volunteer"},
        {"step": 2, "action": "Enter hours and description", "actor": "Volunteer"},
        {"step": 3, "action": "Submit hours", "actor": "Volunteer", "table": "hours"},
        {"step": 4, "action": "Admin reviews", "actor": "Admin"},
        {"step": 5, "action": "Approve/reject hours", "actor": "Admin", "table": "hours"},
        {"step": 6, "action": "Notify volunteer", "actor": "System"}
      ]
    },
    {
      "id": "document_access",
      "name": "Document Access Flow",
      "steps": [
        {"step": 1, "action": "Board member navigates to documents", "actor": "Board Member"},
        {"step": 2, "action": "System checks position permissions", "actor": "System", "table": "staff_board_members"},
        {"step": 3, "action": "Filter documents by access level", "actor": "System", "table": "documents"},
        {"step": 4, "action": "Display accessible documents", "actor": "System"},
        {"step": 5, "action": "User views or downloads document", "actor": "Board Member"},
        {"step": 6, "action": "Log access to audit trail", "actor": "System", "table": "document_access_log"}
      ],
      "permission_matrix": {
        "founder": "all documents - view/download/edit",
        "president": "all documents - view/download/edit",
        "treasurer": "financial docs - full access; others - view only",
        "secretary": "admin docs/minutes/playbooks - edit; financial - view only",
        "board_member": "minutes/policies - view only"
      }
    }
  ],
  "mcp_servers": [
    {
      "name": "supabase",
      "purpose": "Backend database, authentication, storage",
      "capabilities": ["database_crud", "authentication", "storage", "edge_functions", "realtime"],
