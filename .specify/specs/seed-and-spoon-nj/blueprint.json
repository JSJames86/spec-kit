        "subpages": ["/partner", "/partner/apply", "/partner/dashboard", "/partner/referrals", "/partner/referrals/new", "/partner/referrals/[id]"],
        "auth_required": {"apply": false, "dashboard": true, "referrals": true},
        "tables": ["partners", "referrals", "referral_notes", "services"],
        "shadcn_components": ["Form", "Input", "Select", "DataTable", "Dialog", "Badge", "Toast"]
      },
      {
        "path": "/programs",
        "name": "Programs",
