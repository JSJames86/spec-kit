{
  "$schema": "https://seedandspoon.org/schemas/spec-kit-blueprint.json",
  "version": "1.0.0",
  "project": {
    "name": "Seed & Spoon NJ",
    "type": "nonprofit_crm",
    "description": "Nonprofit CRM & Volunteer Management Platform for food insecurity relief",
    "created": "2026-01-12",
    "status": "planning"
  },
  "tech_stack": {
    "frontend": {
      "framework": "Next.js 14+",
      "language": "TypeScript",
      "ui_library": "Shadcn/ui",
      "styling": "Tailwind CSS",
      "state_management": "React Context + Tanstack Query"
    },
    "backend": {
      "database": "Supabase (PostgreSQL)",
      "auth": "Supabase Auth",
      "storage": "Supabase Storage",
      "functions": "Supabase Edge Functions"
    },
    "integrations": {
      "payments": "Stripe",
      "email": "SendGrid/Resend",
      "deployment": "Vercel"
    },
    "testing": {
      "e2e": "Playwright",
      "unit": "Vitest"
    }
  },
  "roles": [
    {
      "id": "super_admin",
      "name": "Super Admin",
      "description": "Full system access, can manage other admins",
      "permissions": ["*"]
    },
    {
      "id": "admin",
      "name": "Admin",
      "description": "Standard administrative access",
      "permissions": ["volunteers:*", "partners:*", "clients:*", "referrals:*", "programs:*", "donations:read", "hours:*", "food_banks:*", "services:*", "campaigns:*"]
    },
    {
      "id": "coordinator",
      "name": "Coordinator",
      "description": "Program and referral coordination",
      "permissions": ["volunteers:read", "volunteers:update", "referrals:*", "programs:*", "hours:*", "clients:read", "clients:update"]
    },
    {
      "id": "volunteer",
      "name": "Volunteer",
      "description": "Registered volunteer",
      "permissions": ["volunteers:read:own", "volunteers:update:own", "programs:read", "hours:read:own", "hours:create:own", "referrals:read:assigned"]
    },
    {
      "id": "partner",
      "name": "Partner",
      "description": "Partner organization",
      "permissions": ["partners:read:own", "partners:update:own", "referrals:read:own", "referrals:create", "services:read"]
    },
    {
      "id": "donor",
      "name": "Donor",
      "description": "Financial donor",
      "permissions": ["donations:read:own", "campaigns:read"]
    },
    {
      "id": "client",
      "name": "Client",
      "description": "Service recipient",
      "permissions": ["clients:read:own", "client_services:read:own"]
    },
    {
      "id": "founder",
      "name": "Founder/President",
      "description": "Organization founder with full authority",
      "permissions": ["*"],
      "document_access": "all",
      "system_access": ["admin_dashboard", "financial_reports", "donation_management", "user_management", "board_portal"],
      "external_tools": {"notion": "admin", "quickbooks": "admin", "google_drive": "admin"}
    },
    {
      "id": "vice_president",
      "name": "Vice President",
      "description": "Second in command",
      "permissions": ["admin_dashboard", "board_portal"],
      "document_access": ["policy", "meeting_minutes", "playbooks", "admin_documents"],
      "external_tools": {"notion": "edit", "google_drive": "edit"}
    },
    {
      "id": "treasurer",
      "name": "Treasurer",
      "description": "Financial oversight",
      "permissions": ["admin_dashboard", "financial_reports", "donation_management", "board_portal"],
      "document_access": ["bank_statements", "accounting_records", "financial_reports", "meeting_minutes", "contracts"],
      "external_tools": {"quickbooks": "admin", "google_drive": "edit"}
    },
    {
      "id": "secretary",
      "name": "Secretary",
      "description": "Records and documentation management",
      "permissions": ["admin_dashboard", "user_management", "board_portal"],
      "document_access": ["meeting_minutes:edit", "admin_documents:edit", "playbooks:edit", "policies:edit", "financial_reports:view"],
      "external_tools": {"notion": "admin", "google_drive": "admin"}
    },
    {
      "id": "board_member",
      "name": "Board Member",
      "description": "Voting board member",
      "permissions": ["board_portal"],
      "document_access": ["meeting_minutes:view", "policies:view", "admin_documents:view", "playbooks:view"],
      "external_tools": {"notion": "view", "google_drive": "view"}
    },
    {
      "id": "staff",
      "name": "Staff",
      "description": "Paid staff member with role-specific access",
      "permissions": ["role_specific"],
      "document_access": ["role_specific"],
      "external_tools": {"notion": "view", "google_drive": "view"}
    }
  ],
  "database": {
    "existing_tables": [
      {
        "name": "volunteers",
        "description": "Registered volunteer profiles",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "user_id", "type": "uuid", "foreign_key": "auth.users.id", "nullable": false},
          {"name": "first_name", "type": "varchar(100)", "nullable": false},
          {"name": "last_name", "type": "varchar(100)", "nullable": false},
          {"name": "email", "type": "varchar(255)", "unique": true, "nullable": false},
          {"name": "phone", "type": "varchar(20)", "nullable": true},
          {"name": "address", "type": "text", "nullable": true},
          {"name": "city", "type": "varchar(100)", "nullable": true},
          {"name": "state", "type": "varchar(2)", "default": "'NJ'"},
          {"name": "zip_code", "type": "varchar(10)", "nullable": true},
          {"name": "availability", "type": "jsonb", "nullable": true},
          {"name": "skills", "type": "text[]", "nullable": true},
          {"name": "status", "type": "varchar(20)", "default": "'pending'", "enum": ["pending", "active", "inactive", "suspended"]},
          {"name": "background_check_status", "type": "varchar(20)", "default": "'not_started'"},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["user_id", "email", "status"]
      },
      {
        "name": "admin_users",
        "description": "Administrative user accounts",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "user_id", "type": "uuid", "foreign_key": "auth.users.id", "unique": true, "nullable": false},
          {"name": "role", "type": "varchar(50)", "default": "'admin'", "enum": ["super_admin", "admin", "coordinator"]},
          {"name": "permissions", "type": "jsonb", "nullable": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["user_id", "role"]
      },
      {
        "name": "donations",
        "description": "Financial donation records",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "user_id", "type": "uuid", "foreign_key": "auth.users.id", "nullable": true},
          {"name": "stripe_payment_intent_id", "type": "varchar(255)", "unique": true, "nullable": false},
          {"name": "stripe_customer_id", "type": "varchar(255)", "nullable": true},
          {"name": "amount_cents", "type": "integer", "nullable": false},
          {"name": "currency", "type": "varchar(3)", "default": "'usd'"},
          {"name": "status", "type": "varchar(20)", "enum": ["pending", "succeeded", "failed", "refunded"]},
          {"name": "donation_type", "type": "varchar(20)", "enum": ["one_time", "recurring"]},
          {"name": "donor_name", "type": "varchar(255)", "nullable": true},
          {"name": "donor_email", "type": "varchar(255)", "nullable": true},
          {"name": "is_anonymous", "type": "boolean", "default": false},
          {"name": "campaign_id", "type": "uuid", "foreign_key": "campaigns.id", "nullable": true},
          {"name": "notes", "type": "text", "nullable": true},
          {"name": "metadata", "type": "jsonb", "nullable": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["user_id", "stripe_payment_intent_id", "status", "created_at"]
      },
      {
        "name": "food_banks",
        "description": "Food bank/pantry locations",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "name", "type": "varchar(255)", "nullable": false},
          {"name": "address", "type": "text", "nullable": false},
          {"name": "city", "type": "varchar(100)", "nullable": false},
          {"name": "state", "type": "varchar(2)", "default": "'NJ'"},
          {"name": "zip_code", "type": "varchar(10)", "nullable": false},
          {"name": "latitude", "type": "decimal(10,8)", "nullable": true},
          {"name": "longitude", "type": "decimal(11,8)", "nullable": true},
          {"name": "phone", "type": "varchar(20)", "nullable": true},
          {"name": "email", "type": "varchar(255)", "nullable": true},
          {"name": "website", "type": "varchar(255)", "nullable": true},
          {"name": "hours_of_operation", "type": "jsonb", "nullable": true},
          {"name": "services_offered", "type": "text[]", "nullable": true},
          {"name": "capacity", "type": "integer", "nullable": true},
          {"name": "is_active", "type": "boolean", "default": true},
          {"name": "contact_person", "type": "varchar(255)", "nullable": true},
          {"name": "notes", "type": "text", "nullable": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["city", "zip_code", "is_active"]
      },
      {
        "name": "services",
        "description": "Types of services offered",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "name", "type": "varchar(255)", "nullable": false},
          {"name": "description", "type": "text", "nullable": true},
          {"name": "category", "type": "varchar(100)", "nullable": true, "enum": ["food_distribution", "meal_delivery", "nutrition_education", "emergency_assistance", "other"]},
          {"name": "is_active", "type": "boolean", "default": true},
          {"name": "eligibility_requirements", "type": "text", "nullable": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["category", "is_active"]
      },
      {
        "name": "hours",
        "description": "Volunteer hour tracking",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "volunteer_id", "type": "uuid", "foreign_key": "volunteers.id", "nullable": false},
          {"name": "program_id", "type": "uuid", "foreign_key": "programs.id", "nullable": true},
          {"name": "date", "type": "date", "nullable": false},
          {"name": "hours_worked", "type": "decimal(4,2)", "nullable": false},
          {"name": "description", "type": "text", "nullable": true},
          {"name": "status", "type": "varchar(20)", "default": "'pending'", "enum": ["pending", "approved", "rejected"]},
          {"name": "approved_by", "type": "uuid", "foreign_key": "admin_users.id", "nullable": true},
          {"name": "approved_at", "type": "timestamptz", "nullable": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["volunteer_id", "program_id", "date", "status"]
      }
    ],
    "new_tables": [
      {
        "name": "clients",
        "description": "Service recipients / beneficiaries",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "user_id", "type": "uuid", "foreign_key": "auth.users.id", "nullable": true},
          {"name": "first_name", "type": "varchar(100)", "nullable": false},
          {"name": "last_name", "type": "varchar(100)", "nullable": false},
          {"name": "email", "type": "varchar(255)", "nullable": true},
          {"name": "phone", "type": "varchar(20)", "nullable": true},
          {"name": "address", "type": "text", "nullable": true},
          {"name": "city", "type": "varchar(100)", "nullable": true},
          {"name": "state", "type": "varchar(2)", "default": "'NJ'"},
          {"name": "zip_code", "type": "varchar(10)", "nullable": true},
          {"name": "household_size", "type": "integer", "nullable": true},
          {"name": "dietary_restrictions", "type": "text[]", "nullable": true},
          {"name": "languages_spoken", "type": "text[]", "default": "'{\"English\"}'"},
          {"name": "income_bracket", "type": "varchar(50)", "nullable": true},
          {"name": "is_veteran", "type": "boolean", "default": false},
          {"name": "is_senior", "type": "boolean", "default": false},
          {"name": "has_children", "type": "boolean", "default": false},
          {"name": "special_needs", "type": "text", "nullable": true},
          {"name": "status", "type": "varchar(20)", "default": "'active'", "enum": ["active", "inactive", "archived"]},
          {"name": "intake_date", "type": "date", "default": "current_date"},
          {"name": "referred_by", "type": "uuid", "foreign_key": "partners.id", "nullable": true},
          {"name": "notes", "type": "text", "nullable": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["user_id", "email", "zip_code", "status", "intake_date"]
      },
      {
        "name": "partners",
        "description": "Partner organizations",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "user_id", "type": "uuid", "foreign_key": "auth.users.id", "nullable": true},
          {"name": "organization_name", "type": "varchar(255)", "nullable": false},
          {"name": "organization_type", "type": "varchar(100)", "enum": ["church", "school", "social_services", "healthcare", "government", "nonprofit", "business", "other"]},
          {"name": "contact_name", "type": "varchar(255)", "nullable": false},
          {"name": "contact_email", "type": "varchar(255)", "nullable": false},
          {"name": "contact_phone", "type": "varchar(20)", "nullable": true},
          {"name": "address", "type": "text", "nullable": true},
          {"name": "city", "type": "varchar(100)", "nullable": true},
          {"name": "state", "type": "varchar(2)", "default": "'NJ'"},
          {"name": "zip_code", "type": "varchar(10)", "nullable": true},
          {"name": "website", "type": "varchar(255)", "nullable": true},
          {"name": "partnership_type", "type": "varchar(50)", "enum": ["referral_source", "service_provider", "funding_partner", "volunteer_source", "other"]},
          {"name": "mou_signed", "type": "boolean", "default": false},
          {"name": "mou_signed_date", "type": "date", "nullable": true},
          {"name": "status", "type": "varchar(20)", "default": "'pending'", "enum": ["pending", "active", "inactive", "suspended"]},
          {"name": "notes", "type": "text", "nullable": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["user_id", "organization_type", "partnership_type", "status"]
      },
      {
        "name": "programs",
        "description": "Volunteer programs and initiatives",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "name", "type": "varchar(255)", "nullable": false},
          {"name": "description", "type": "text", "nullable": true},
          {"name": "program_type", "type": "varchar(100)", "enum": ["food_distribution", "meal_delivery", "community_garden", "education", "fundraising", "administrative", "other"]},
          {"name": "service_id", "type": "uuid", "foreign_key": "services.id", "nullable": true},
          {"name": "food_bank_id", "type": "uuid", "foreign_key": "food_banks.id", "nullable": true},
          {"name": "coordinator_id", "type": "uuid", "foreign_key": "admin_users.id", "nullable": true},
          {"name": "start_date", "type": "date", "nullable": true},
          {"name": "end_date", "type": "date", "nullable": true},
          {"name": "recurrence", "type": "varchar(50)", "nullable": true, "enum": ["one_time", "daily", "weekly", "biweekly", "monthly"]},
          {"name": "schedule", "type": "jsonb", "nullable": true},
          {"name": "location", "type": "text", "nullable": true},
          {"name": "max_volunteers", "type": "integer", "nullable": true},
          {"name": "min_volunteers", "type": "integer", "nullable": true},
          {"name": "requirements", "type": "text[]", "nullable": true},
          {"name": "is_active", "type": "boolean", "default": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["program_type", "service_id", "food_bank_id", "is_active", "start_date"]
      },
      {
        "name": "referrals",
        "description": "Client referrals from partners",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "referral_number", "type": "varchar(20)", "unique": true, "nullable": false},
          {"name": "partner_id", "type": "uuid", "foreign_key": "partners.id", "nullable": false},
          {"name": "client_id", "type": "uuid", "foreign_key": "clients.id", "nullable": true},
          {"name": "service_id", "type": "uuid", "foreign_key": "services.id", "nullable": false},
          {"name": "assigned_volunteer_id", "type": "uuid", "foreign_key": "volunteers.id", "nullable": true},
          {"name": "assigned_food_bank_id", "type": "uuid", "foreign_key": "food_banks.id", "nullable": true},
          {"name": "client_first_name", "type": "varchar(100)", "nullable": false},
          {"name": "client_last_name", "type": "varchar(100)", "nullable": false},
          {"name": "client_phone", "type": "varchar(20)", "nullable": true},
          {"name": "client_email", "type": "varchar(255)", "nullable": true},
          {"name": "client_address", "type": "text", "nullable": true},
          {"name": "client_city", "type": "varchar(100)", "nullable": true},
          {"name": "client_zip_code", "type": "varchar(10)", "nullable": true},
          {"name": "household_size", "type": "integer", "nullable": true},
          {"name": "urgency", "type": "varchar(20)", "default": "'normal'", "enum": ["low", "normal", "high", "emergency"]},
          {"name": "status", "type": "varchar(30)", "default": "'submitted'", "enum": ["submitted", "under_review", "accepted", "assigned", "in_progress", "completed", "closed", "rejected"]},
          {"name": "reason_for_referral", "type": "text", "nullable": true},
          {"name": "special_instructions", "type": "text", "nullable": true},
          {"name": "intake_completed", "type": "boolean", "default": false},
          {"name": "intake_completed_at", "type": "timestamptz", "nullable": true},
          {"name": "intake_completed_by", "type": "uuid", "foreign_key": "admin_users.id", "nullable": true},
          {"name": "outcome", "type": "text", "nullable": true},
          {"name": "outcome_date", "type": "date", "nullable": true},
          {"name": "follow_up_required", "type": "boolean", "default": false},
          {"name": "follow_up_date", "type": "date", "nullable": true},
          {"name": "notes", "type": "text", "nullable": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["referral_number", "partner_id", "client_id", "service_id", "assigned_volunteer_id", "status", "urgency", "created_at"]
      },
      {
        "name": "volunteer_programs",
        "description": "Junction: Volunteers assigned to Programs",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "volunteer_id", "type": "uuid", "foreign_key": "volunteers.id", "nullable": false},
          {"name": "program_id", "type": "uuid", "foreign_key": "programs.id", "nullable": false},
          {"name": "role", "type": "varchar(50)", "default": "'participant'", "enum": ["participant", "team_lead", "coordinator"]},
          {"name": "status", "type": "varchar(20)", "default": "'active'", "enum": ["pending", "active", "completed", "withdrawn"]},
          {"name": "joined_at", "type": "timestamptz", "default": "now()"},
          {"name": "left_at", "type": "timestamptz", "nullable": true},
          {"name": "notes", "type": "text", "nullable": true}
        ],
        "indexes": ["volunteer_id", "program_id", "status"],
        "constraints": {"unique": ["volunteer_id", "program_id"]}
      },
      {
        "name": "client_services",
        "description": "Junction: Clients receiving Services",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "client_id", "type": "uuid", "foreign_key": "clients.id", "nullable": false},
          {"name": "service_id", "type": "uuid", "foreign_key": "services.id", "nullable": false},
          {"name": "referral_id", "type": "uuid", "foreign_key": "referrals.id", "nullable": true},
          {"name": "food_bank_id", "type": "uuid", "foreign_key": "food_banks.id", "nullable": true},
          {"name": "start_date", "type": "date", "default": "current_date"},
          {"name": "end_date", "type": "date", "nullable": true},
          {"name": "frequency", "type": "varchar(50)", "nullable": true, "enum": ["one_time", "weekly", "biweekly", "monthly", "as_needed"]},
          {"name": "status", "type": "varchar(20)", "default": "'active'", "enum": ["active", "paused", "completed", "cancelled"]},
          {"name": "notes", "type": "text", "nullable": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["client_id", "service_id", "referral_id", "status"]
      },
      {
        "name": "referral_notes",
        "description": "Activity log for referrals",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "referral_id", "type": "uuid", "foreign_key": "referrals.id", "nullable": false},
          {"name": "author_id", "type": "uuid", "foreign_key": "auth.users.id", "nullable": false},
          {"name": "author_type", "type": "varchar(20)", "enum": ["admin", "volunteer", "partner"]},
          {"name": "note_type", "type": "varchar(30)", "enum": ["status_change", "assignment", "contact_attempt", "service_delivery", "follow_up", "general"]},
          {"name": "content", "type": "text", "nullable": false},
          {"name": "is_internal", "type": "boolean", "default": false},
          {"name": "created_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["referral_id", "author_id", "note_type", "created_at"]
      },
      {
        "name": "campaigns",
        "description": "Donation campaigns",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "name", "type": "varchar(255)", "nullable": false},
          {"name": "slug", "type": "varchar(100)", "unique": true, "nullable": false},
          {"name": "description", "type": "text", "nullable": true},
          {"name": "goal_amount_cents", "type": "integer", "nullable": true},
          {"name": "raised_amount_cents", "type": "integer", "default": 0},
          {"name": "start_date", "type": "date", "nullable": true},
          {"name": "end_date", "type": "date", "nullable": true},
          {"name": "is_active", "type": "boolean", "default": true},
          {"name": "image_url", "type": "varchar(500)", "nullable": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["slug", "is_active", "start_date", "end_date"]
      },
      {
        "name": "staff_board_members",
        "description": "Staff and board member profiles with role-based document/system access",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "user_id", "type": "uuid", "foreign_key": "auth.users.id", "unique": true, "nullable": false},
          {"name": "first_name", "type": "varchar(100)", "nullable": false},
          {"name": "last_name", "type": "varchar(100)", "nullable": false},
          {"name": "email", "type": "varchar(255)", "unique": true, "nullable": false},
          {"name": "phone", "type": "varchar(20)", "nullable": true},
          {"name": "position", "type": "varchar(50)", "nullable": false, "enum": ["founder", "president", "vice_president", "treasurer", "secretary", "board_member", "staff"]},
          {"name": "title", "type": "varchar(255)", "nullable": true},
          {"name": "department", "type": "varchar(100)", "nullable": true, "enum": ["executive", "finance", "operations", "programs", "development", "communications"]},
          {"name": "is_voting_member", "type": "boolean", "default": false},
          {"name": "term_start_date", "type": "date", "nullable": true},
          {"name": "term_end_date", "type": "date", "nullable": true},
          {"name": "employment_type", "type": "varchar(30)", "nullable": true, "enum": ["volunteer_board", "part_time", "full_time", "contractor"]},
          {"name": "bio", "type": "text", "nullable": true},
          {"name": "photo_url", "type": "varchar(500)", "nullable": true},
          {"name": "is_active", "type": "boolean", "default": true},
          {"name": "permissions", "type": "jsonb", "nullable": true},
          {"name": "external_integrations", "type": "jsonb", "nullable": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["user_id", "email", "position", "is_active"],
        "permission_schema": {
          "documents": {
            "bank_statements": {"values": ["none", "view", "download"]},
            "accounting_records": {"values": ["none", "view", "download", "edit"]},
            "financial_reports": {"values": ["none", "view", "download"]},
            "meeting_minutes": {"values": ["none", "view", "edit"]},
            "admin_documents": {"values": ["none", "view", "edit"]},
            "playbooks": {"values": ["none", "view", "edit"]},
            "policies": {"values": ["none", "view", "edit"]},
            "contracts": {"values": ["none", "view", "download", "edit"]}
          },
          "systems": {
            "admin_dashboard": {"type": "boolean"},
            "financial_reports": {"type": "boolean"},
            "donation_management": {"type": "boolean"},
            "user_management": {"type": "boolean"},
            "board_portal": {"type": "boolean"}
          },
          "external_tools": {
            "notion": {"values": ["none", "view", "edit", "admin"]},
            "quickbooks": {"values": ["none", "view", "edit", "admin"]},
            "google_drive": {"values": ["none", "view", "edit", "admin"]}
          }
        }
      },
      {
        "name": "documents",
        "description": "Organizational documents with role-based access control",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "title", "type": "varchar(255)", "nullable": false},
          {"name": "description", "type": "text", "nullable": true},
          {"name": "document_type", "type": "varchar(50)", "nullable": false, "enum": ["bank_statement", "accounting_record", "financial_report", "meeting_minutes", "admin_document", "playbook", "policy", "contract", "tax_document", "grant_application", "board_resolution", "other"]},
          {"name": "category", "type": "varchar(50)", "nullable": true, "enum": ["financial", "governance", "operations", "legal", "hr", "programs", "communications"]},
          {"name": "file_url", "type": "varchar(500)", "nullable": false},
          {"name": "file_name", "type": "varchar(255)", "nullable": false},
          {"name": "file_size_bytes", "type": "integer", "nullable": true},
          {"name": "mime_type", "type": "varchar(100)", "nullable": true},
          {"name": "version", "type": "integer", "default": 1},
          {"name": "parent_document_id", "type": "uuid", "foreign_key": "documents.id", "nullable": true},
          {"name": "uploaded_by", "type": "uuid", "foreign_key": "auth.users.id", "nullable": false},
          {"name": "fiscal_year", "type": "integer", "nullable": true},
          {"name": "fiscal_month", "type": "integer", "nullable": true},
          {"name": "meeting_date", "type": "date", "nullable": true},
          {"name": "effective_date", "type": "date", "nullable": true},
          {"name": "expiration_date", "type": "date", "nullable": true},
          {"name": "is_confidential", "type": "boolean", "default": false},
          {"name": "is_archived", "type": "boolean", "default": false},
          {"name": "tags", "type": "text[]", "nullable": true},
          {"name": "metadata", "type": "jsonb", "nullable": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"},
          {"name": "updated_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["document_type", "category", "uploaded_by", "fiscal_year", "meeting_date", "is_archived", "created_at"]
      },
      {
        "name": "document_access_log",
        "description": "Audit trail for document access and modifications",
        "columns": [
          {"name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()"},
          {"name": "document_id", "type": "uuid", "foreign_key": "documents.id", "nullable": false},
          {"name": "user_id", "type": "uuid", "foreign_key": "auth.users.id", "nullable": false},
          {"name": "action", "type": "varchar(30)", "nullable": false, "enum": ["view", "download", "upload", "edit", "delete", "share", "permission_change"]},
          {"name": "ip_address", "type": "inet", "nullable": true},
          {"name": "user_agent", "type": "text", "nullable": true},
          {"name": "details", "type": "jsonb", "nullable": true},
          {"name": "created_at", "type": "timestamptz", "default": "now()"}
        ],
        "indexes": ["document_id", "user_id", "action", "created_at"]
      }
    ]
  },
  "frontend": {
    "existing_pages": [
      {
        "path": "/",
        "name": "Homepage",
        "description": "Landing page with mission statement and CTAs",
        "auth_required": false
      }
    ],
    "existing_components": [
      {"name": "Header", "description": "Global navigation header"},
      {"name": "Footer", "description": "Global footer with links"}
    ],
    "new_pages": [
      {
        "path": "/volunteer",
        "name": "Volunteer Portal",
        "subpages": ["/volunteer", "/volunteer/register", "/volunteer/dashboard", "/volunteer/hours", "/volunteer/programs"],
        "auth_required": {"register": false, "dashboard": true, "hours": true, "programs": true},
        "tables": ["volunteers", "volunteer_programs", "programs", "hours"],
        "shadcn_components": ["Form", "Input", "Select", "Checkbox", "Card", "Badge", "Tabs", "Calendar", "Toast"]
      },
      {
        "path": "/partner",
