        "subpages": ["/admin", "/admin/volunteers", "/admin/partners", "/admin/clients", "/admin/referrals", "/admin/programs", "/admin/donations", "/admin/hours", "/admin/food-banks", "/admin/services", "/admin/users", "/admin/board", "/admin/documents"],
        "auth_required": true,
